@model ShippingAddressOutputDto

@{
}

<div class="col-md-2">
    <span class="stext-110 cl2">
        Gönderim Adresi:
    </span>
</div>

<div class="col-md-10">
    <div class="row gx-4">
        <div class="bg0 m-b-22 col-12">
            <span class="stext-112 cl8">
                @Model.NeighborhoodName / @Model.DistrictName / @Model.CityName
                <br />
                Posta Kodu: @Model.Postcode
                <br />
                Sokak/Cadde: @Model.Street
                <br />
                Bina No: @Model.BuildingNo
                <br />
                Kat: @Model.Floor - Daire No: @Model.ApartmentNo
                <br />
                Detaylı Adres: @Model.AddressLine
            </span>
        </div>
    </div>

</div>