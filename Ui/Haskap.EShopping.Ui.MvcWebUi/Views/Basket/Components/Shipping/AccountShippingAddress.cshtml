@using Modules.Shipping.Application.Dtos
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model ShippingAddressOutputDto

<div class="flex-w flex-t bor12 p-t-15 p-b-30">
	<div class="size-208 w-full-ssm">
		<span class="stext-110 cl2">
			Shipping:
		</span>
	</div>

	<div class="size-209 p-r-18 p-r-0-sm w-full-ssm">
		<div>
			<span class="stext-112 cl8">
                @Model.CityName / @Model.DistrictName / @Model.NeighborhoodName
				<br />
                Posta Kodu: @Model.Postcode
				<br />
				Sokak/Cadde: @Model.Street
				<br />
                Bina No: @Model.BuildingNo
				<br />
                Kat: @Model.Floor - Daire No: @Model.ApartmentNo
				<br />
				Detaylı Adres: @Model.AddressLine
			</span>
		</div>
	</div>

	<div class="size-208 w-full-ssm">
		<span class="stext-110 cl2">
			Kargo Ücreti:
		</span>
	</div>
	<div class="size-209 p-r-18 p-r-0-sm w-full-ssm">
		<span class="mtext-110 cl2">
			@(ViewBag.Basket.HasFreeShippingCoupon ? Html.Raw($"<s>{ViewBag.Basket.ShippingFee.StringRepresentation}</s> Ücretsiz Kargo") : ViewBag.Basket.ShippingFee.StringRepresentation)
		</span>
	</div>
</div>
