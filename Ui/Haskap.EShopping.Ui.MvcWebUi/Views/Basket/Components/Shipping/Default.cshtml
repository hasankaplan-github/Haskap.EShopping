@using Modules.Shipping.Application.Dtos
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
}

@model ShippingAddressInputDto?

<div class="flex-w flex-t bor12 p-t-15 p-b-30">
	<div class="size-208 w-full-ssm">
		<span class="stext-110 cl2">
			Shipping:
		</span>
	</div>

	<div class="size-209 p-r-18 p-r-0-sm w-full-ssm">
		@if (Model is null ||
			Model.CityId is null ||
			Model.DistrictId is null ||
			Model.NeighborhoodId is null)
		{
			<p class="stext-111 cl6 p-t-2 text-danger">
                Kargo ücretinin hesaplanabilmesi için adres bilgilerinizi girmeniz gerekmektedir.
			</p>
		}

		<div>
			@* <span class="stext-112 cl8">
										Calculate Shipping
									</span> *@

			<div class="rs1-select2 rs2-select2 bor8 bg0 m-b-12 m-t-9">
				<select class="js-select2" id="citySelect">
					<option selected="@(Model?.CityId is null)">İl Seçiniz...</option>
					@foreach (var city in ViewBag.Cities)
					{
						<option value="@city.Id" selected="@(Model?.CityId == city.Id)">@city.Name</option>
					}
				</select>
				<div class="dropDownSelect2"></div>
			</div>

			<div class="rs1-select2 rs2-select2 bor8 bg0 m-b-12">
				<select class="js-select2" id="districtSelect">
					<option selected="@(Model?.DistrictId is null)">İlçe Seçiniz...</option>
                    @foreach (var district in ViewBag.Districts)
                    {
                        <option value="@district.Id" selected="@(Model!.DistrictId == district.Id)">@district.Name</option>
                    }
				</select>
				<div class="dropDownSelect2"></div>
			</div>

			<div class="rs1-select2 rs2-select2 bor8 bg0 m-b-12">
				<select class="js-select2" id="neighborhoodSelect" onchange="loadBasketViewComponent();">
					<option selected="@(Model?.NeighborhoodId is null)">Mahalle Seçiniz...</option>
                    @foreach (var neighborhood in ViewBag.Neighborhoods)
                    {
                        <option value="@neighborhood.Id" selected="@(Model!.NeighborhoodId == neighborhood.Id)">@neighborhood.Name</option>
                    }
				</select>
				<div class="dropDownSelect2"></div>
			</div>

			<div class="bor8 bg0 m-b-22">
				<input class="stext-111 cl8 plh3 size-111 p-lr-15" type="text" id="streetInput" placeholder="Sokak/Cadde" value="@Model?.Street">
			</div>

			<div class="bor8 bg0 m-b-22">
				<input class="stext-111 cl8 plh3 size-111 p-lr-15" type="text" id="postcodeInput" placeholder="Postcode / Zip" value="@Model?.Postcode">
			</div>

			<div class="bor8 bg0 m-b-22">
				<input class="stext-111 cl8 plh3 size-111 p-lr-15" type="text" id="buildingNoInput" placeholder="Bina No" value="@Model?.BuildingNo">
			</div>

			<div class="bor8 bg0 m-b-22">
				<input class="stext-111 cl8 plh3 size-111 p-lr-15" type="number" id="floorInput" placeholder="Kat" value="@Model?.Floor">
			</div>

			<div class="bor8 bg0 m-b-22">
				<input class="stext-111 cl8 plh3 size-111 p-lr-15" type="number" id="apartmentNoInput" placeholder="Daire No" value="@Model?.ApartmentNo">
			</div>

			<div class="bor8 bg0 m-b-22">
				<textarea class="stext-111 cl8 plh3 size-111 p-lr-15" id="addressLineTextarea" placeholder="Detaylı adres">@Model?.AddressLine</textarea>
			</div>

			@* <div class="flex-w">
										<div class="flex-c-m stext-101 cl2 size-115 bg8 bor13 hov-btn3 p-lr-15 trans-04 pointer">
											Update Totals
										</div>
									</div> *@

		</div>

	</div>

	<div class="size-208 w-full-ssm">
		<span class="stext-110 cl2">
			Kargo Ücreti:
		</span>
	</div>
	<div class="size-209 p-r-18 p-r-0-sm w-full-ssm">
		<span class="mtext-110 cl2">
			@(ViewBag.Basket.HasFreeShippingCoupon ? Html.Raw($"<s>{ViewBag.Basket.ShippingFee.StringRepresentation}</s> Ücretsiz Kargo") : ViewBag.Basket.ShippingFee.StringRepresentation)
		</span>
	</div>
</div>
