@using Haskap.EShopping.Domain.Common
@using Modules.Basket.Application.Dtos
@using Haskap.EShopping.Application.Mappings

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@model BasketOutputDto

@{
}


<!-- Shoping Cart -->
<div class="bg0 p-t-75 p-b-85">
	<div class="container">
		@if (Model.Items.Count == 0)
		{
			<div class="text-center">
				<h2 class="mtext-105 cl2 txt-center">
					Sepetinizde ürün bulunmuyor.
				</h2>
			</div>
		}
		else
		{
			<div class="row">
				<div class="col-lg-10 col-xl-7 m-lr-auto m-b-50">
					<div class="m-l-25 m-r--38 m-lr-0-xl">
						<div class="wrap-table-shopping-cart">
							<table class="table-shopping-cart">
								<tr class="table_head">
									<th class="column-1">Product</th>
									<th class="column-2"></th>
									<th class="column-3">Price</th>
									<th class="column-4">Quantity</th>
									<th class="column-5">Total</th>
								</tr>

								@foreach (var item in Model.Items.OrderBy(i => i.VariantSkuValue))
								{
									<tr class="table_row">
										<td class="column-1">
											<div class="how-itemcart1">
												<img src="@Url.Action("GetProductPhotoPhysicalFile", "Catalog", new { VariantId = item.VariantId, FileName = item.PrimaryPicture.PhotoFile.NewName + item.PrimaryPicture.PhotoFile.Extension })" alt="IMG">
											</div>
										</td>
										<td class="column-2">@item.ProductName</td>
										<td class="column-3">@item.Price.StringRepresentation</td>
										<td class="column-4">
											<div class="wrap-num-product flex-w m-l-auto m-r-0">
												<div class="btn-num-product-down cl8 hov-btn3 trans-04 flex-c-m">
													<i class="fs-16 zmdi zmdi-minus"></i>
												</div>

												<input 
													class="mtext-104 cl3 txt-center num-product" 
													type="number" 
													name="num-product1" 
													value="@item.Quantity"
													data-previous-value="@item.Quantity"
													oninput="updateBasket('@item.ProductId', '@item.VariantId', this);">

												<div class="btn-num-product-up cl8 hov-btn3 trans-04 flex-c-m">
													<i class="fs-16 zmdi zmdi-plus"></i>
												</div>
											</div>
										</td>
										<td class="column-5">@(item.Total.Value != item.TotalWithDiscount.Value ? Html.Raw($"<s>{item.Total.StringRepresentation}</s><br/>{item.TotalWithDiscount.StringRepresentation}") : item.Total.StringRepresentation)</td>
									</tr>
								}
							
							</table>
						</div>

						<div class="flex-w flex-sb-m bor15 p-t-18 p-b-15 p-lr-40 p-lr-15-sm">
							<div class="flex-w flex-m m-r-20 m-tb-5">
								<input class="stext-104 cl2 plh4 size-117 bor13 p-lr-20 m-r-10 m-tb-5" type="text" id="specialCouponCodeInput" placeholder="Coupon Code">

								<div class="flex-c-m stext-101 cl2 size-118 bg8 bor13 hov-btn3 p-lr-15 trans-04 pointer m-tb-5" id="applySpecialCouponDiv">
									Kupon Kodu Uygula
								</div>
							</div>

							@* <div class="flex-c-m stext-101 cl2 size-119 bg8 bor13 hov-btn3 p-lr-15 trans-04 pointer m-tb-10">
								Update Cart
							</div> *@
						</div>

						<div class="row">
							@foreach (var possibleCoupon in Model.AllPossibleCoupons)
							{
								if (possibleCoupon.IsApplied)
								{
									<div class="col-6 col-md-4">
										<div class="card border-success">
											<div class="card-body">
												<h5 class="card-title text-success">Uygulandı</h5>
												<p class="card-text">@possibleCoupon.Description</p>
												<p class="card-text"><strong>@possibleCoupon.DiscountAmount.StringRepresentation</strong></p>
											</div>
											<div class="card-footer d-flex justify-content-end">
												@if (possibleCoupon.IsSpecialCoupon)
												{
													<button class="card-link text-danger" onclick="removeSpecialCoupon('@possibleCoupon.Id');">Kaldır</button>
												}
												else
												{
													<button class="card-link text-danger" onclick="removeRegularCoupon('@possibleCoupon.Id');">Kaldır</button>
												}
											</div>
										</div>
									</div>
								}
								else
								{
									<div class="col-6 col-md-4">
										<div class="card border-danger">
											<div class="card-body">
												<h5 class="card-title text-danger">Uygulanmadı</h5>
												<p class="card-text">@possibleCoupon.Description</p>
												<p class="card-text"><strong>@possibleCoupon.DiscountAmount.StringRepresentation</strong></p>
											</div>
											<div class="card-footer d-flex justify-content-end">
												<button class="card-link text-success" onclick="applyRegularCoupon('@possibleCoupon.Id');">Uygula</button>
											</div>
										</div>
									</div>
								}
							}
						</div>
						
					</div>
				</div>

				<div class="col-sm-10 col-lg-7 col-xl-5 m-lr-auto m-b-50">
					<div class="bor10 p-lr-40 p-t-30 p-b-40 m-l-63 m-r-40 m-lr-0-xl p-lr-15-sm">
						<h4 class="mtext-109 cl2 p-b-30">
							Totals
						</h4>

						@{
							var totalDiscount = Model.Total.Value - Model.TotalWithDiscount.Value;
						}

						@if (totalDiscount > 0)
						{
							<div class="flex-w flex-t bor12 p-b-13">
								<div class="size-208">
									<span class="stext-110 cl2">
										Toplam İndirim:
									</span>
								</div>

								<div class="size-209">
									<span class="mtext-110 cl2">
										@(new Money(totalDiscount).ToString())
									</span>
								</div>
							</div>
						}

						<div class="flex-w flex-t bor12 p-t-15 p-b-13">
							<div class="size-208">
								<span class="stext-110 cl2">
									Ara Toplam:
								</span>
							</div>

							<div class="size-209">
								<span class="mtext-110 cl2">
									@(totalDiscount > 0 ? Html.Raw($"<s>{Model.Total.StringRepresentation}</s><br/>{Model.TotalWithDiscount.StringRepresentation}") : Model.Total.StringRepresentation)
								</span>
							</div>
						</div>

						<vc:shipping 
							basket="@Model"
							shipping-address="@ViewBag.ShippingAddress">
						</vc:shipping>

						<div class="flex-w flex-t p-t-27 p-b-33">
							<div class="size-208">
								<span class="mtext-101 cl2">
									Toplam:
								</span>
							</div>

							<div class="size-209 p-t-1">
								<span class="mtext-110 cl2">
									@(new Money(Model.TotalWithDiscount.Value + Model.ShippingFee.Value).ToString())
								</span>
							</div>
						</div>

						<button class="flex-c-m stext-101 cl0 size-116 bg3 bor14 hov-btn3 p-lr-15 trans-04 pointer" id="proceedToCreatingOrderButton">
							Sipariş Oluşturmak İçin İlerle
						</button>
					</div>
				</div>
			</div>
		}
	</div>
</div>