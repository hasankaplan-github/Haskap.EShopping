@using Haskap.DddBase.Domain.Providers;

@inject ICurrentTenantProvider currentTenantProvider
@inject ICurrentUserIdProvider CurrentUserIdProvider
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}


<!-- Modal -->
<div class="modal fade" id="userUpdatePermissionsModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable modal-lg">
        <div id="userUpdatePermissionsModalContent" class="modal-content">
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="userUpdateRolesModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-scrollable">
        <div id="userUpdateRolesModalContent" class="modal-content">
        </div>
    </div>
</div>


<div class="card">
    <div class="card-body">
        <div class="row">
            <h5 class="card-title">Kullanıcı Arama Parametreleri</h5>
        </div>

        <div class="row">
            <div class="col-md-3">
                <label for="searchUserFirstNameInput" class="form-label">İsim</label>
                <input type="text" maxlength="100" class="form-control" id="searchUserFirstNameInput" aria-describedby="searchUserFirstNameInput">
            </div>

            <div class="col-md-3">
                <label for="searchUserLastNameInput" class="form-label">Soyisim</label>
                <input type="text" maxlength="100" class="form-control" id="searchUserLastNameInput" aria-describedby="searchUserLastNameInput">
            </div>

            <div class="col-md-3">
                <label for="searchUserUsernameInput" class="form-label">Kullanıcı Adı</label>
                <input type="text" maxlength="100" class="form-control" id="searchUserUsernameInput" aria-describedby="searchUserUsernameInput">
            </div>
        </div>

    </div>
    <!-- /.card-body -->

    <div class="card-footer">
        <button id="searchButton" type="button" class="btn btn-primary float-right">Ara</button>
    </div>
    <!-- /.card-footer -->
</div>
<!-- /.card -->

<div class="card card-primary">
    <div class="card-header">
        <h3 class="card-title">Arama Sonuçları</h3>
    </div>

    <div class="card-body">
        <div class="row">
            <table id="searchResultTable" class="table table-bordered table-striped compact">
            </table>
        </div>
    </div>
    <!-- /.card-body -->
</div>
<!-- /.card -->


