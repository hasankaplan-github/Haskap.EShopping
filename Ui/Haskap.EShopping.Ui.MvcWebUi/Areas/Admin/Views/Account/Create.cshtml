@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}

<div class="row">
    <div class="col-md-12">
        
    </div>
</div>

<div class="row">
    <div class="col-md-6">
        <label>Kullanıcı Adı : </label>
        <input type="text" id="username" class="form-control" />

        <label>Ad : </label>
        <input type="text" id="firstName" class="form-control" />

        <label>Soyad : </label>
        <input type="text" id="lastName" class="form-control" />

        <label>Eposta Adresi : </label>
        <input type="text" id="emailAddress" class="form-control" />

        <button class="btn btn-primary" id="createNewUserButton">Kaydet</button>
    </div>

    <div class="col-md-6">
        <label>New Password : </label>
        <label id="newPassword"></label>
    </div>
</div>

@section Scripts
{
    <script>

        $('#createNewUserButton').click(function () {
            var username = $('#username').val();
            var firstName = $('#firstName').val();
            var lastName = $('#lastName').val();
            var emailAddress = $('#emailAddress').val();

            $.ajax({
                type: "POST",
                headers: {
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                url: '@Url.Action("Create", "Account", new { area = "Admin" })',
                data: {
                    username: username,
                    firstName: firstName,
                    lastName: lastName,
                    emailAddress: emailAddress
                }
            }).done(function (result, status, xhr) {
                Swal.fire('Başarılı', 'Kullanıcı başarıyla oluşturuldu', 'success');

                $('#newPassword').text(result.clearPassword);
            });
        });

    </script>
}
