@using System.Security.Claims
@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var area = Context.GetRouteValue("area")?.ToString();
    var controller = Context.GetRouteValue("controller")?.ToString();
    var action = Context.GetRouteValue("action")?.ToString();

    var returnUrl = $"/{(string.IsNullOrWhiteSpace(area) ? string.Empty : (area + "/"))}{(string.IsNullOrWhiteSpace(controller) ? string.Empty : (controller + "/"))}{action}";
}

<!--begin::User Menu Dropdown-->
<li class="nav-item dropdown user-menu">
    <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
        <img src="~/lib/AdminLTE-4.0.0-rc7/dist/assets/img/default_user.png"
             class="user-image rounded-circle shadow"
             alt="User Image" />
        <span class="d-none d-md-inline">@Html.Raw(User.Claims.Where(x => x.Type == ClaimTypes.Name).FirstOrDefault()?.Value)</span>
    </a>
    <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
        <!--begin::User Image-->
        <li class="user-header text-bg-primary">
            <img src="~/lib/AdminLTE-4.0.0-rc7/dist/assets/img/default_user.png"
                 class="rounded-circle shadow"
                 alt="User Image" />
            <p>
                @Html.Raw(User.Claims.Where(x => x.Type == ClaimTypes.Name).FirstOrDefault()?.Value)
                <small>Member since Nov. 2023</small>
            </p>
        </li>
        <!--end::User Image-->
        <!--begin::Menu Body-->
        <li class="user-body">
            <!--begin::Row-->
            @* <div class="row">
                <div class="col-4 text-center">
                    <a href="#">Followers</a>
                </div>
                <div class="col-4 text-center">
                    <a href="#">Sales</a>
                </div>
                <div class="col-4 text-center">
                    <a href="#">Friends</a>
                </div>
            </div> *@
            <!--end::Row-->
        </li>
        <!--end::Menu Body-->
        <!--begin::Menu Footer-->
        <li class="user-footer">
            <a class="btn btn-outline-secondary" asp-action="CurrentUserProfile" asp-controller="Account" asp-area="Admin">Profile</a>
            <a class="btn btn-outline-danger float-end" asp-action="Logout" asp-controller="Account" asp-area="" asp-route-returnUrl="@returnUrl">Sign out</a>
        </li>
        <!--end::Menu Footer-->
    </ul>
</li>
<!--end::User Menu Dropdown-->