@using Modules.Catalog.Application.Backoffice.Dtos.Product

@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@model DetailsOutputDto

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@
@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;
}


<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">

        <vc:content-header title="Ürün Detayları"></vc:content-header>

        <div class="row">
            <div class="col-md-12">

                <div class="card card-primary card-outline mb-4">
                    <!--begin::Header-->
                    <div class="card-header">
                        <div class="card-title">Ürün Bilgileri</div>
                    </div>
                    <!--end::Header-->
                    <!--begin::Body-->
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="nameInput" class="form-label">Ürün Adı</label>
                                <input type="text" class="form-control" id="nameInput" disabled value="@Model.Name" />
                            </div>

                            <div class="col-md-4">
                                <label for="descriptionInput" class="form-label">Ürün Açıklaması</label>
                                <input type="text" class="form-control" id="descriptionInput" disabled value="@Model.Description" />
                            </div>

                            <div class="col-md-4">
                                <label for="skuValueInput" class="form-label">Ürün SKU Değeri</label>
                                <input type="text" class="form-control" id="skuValueInput" disabled value="@Model.SkuValue" />
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-8">
                                <label for="categoriesSelect" class="form-label">Ürün Kategorileri</label>
                                <select id="categoriesSelect" class="select2" multiple="multiple" style="width: 100%;" disabled>
                                    @foreach (var category in Model.Categories)
                                    {
                                        <option value="@category.Id" selected="selected">@category.Name</option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label class="form-label">Aktiflik</label>
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="isActiveInput" disabled @(Model.IsActive ? "checked" : "") />
                                    <label class="form-check-label" for="isActiveInput">Aktif</label>
                                </div>
                            </div>
                        </div>
                        
                    </div>
                    <!--end::Body-->
                    <!--begin::Footer-->
                    @* <div class="card-footer d-flex justify-content-end">
                        <button type="button" class="btn btn-primary" id="saveButton">Kaydet</button>
                    </div> *@
                    <!--end::Footer-->
                </div>

            </div>
        </div>
    
        <div class="row">
            <div class="col-md-12">

                <div class="card card-primary card-outline mb-4">
                    <!--begin::Header-->
                    <div class="card-header">
                        <div class="card-title">Ürün Variantları</div>

                        <div class="card-tools">
                            <a id="createProductVariantButton" class="btn btn-primary btn-sm" asp-action="CreateVariant" asp-controller="Product" asp-area="Admin" asp-route-productId="@Model.Id">Ürün Variantı Oluştur</a>
                        </div>
                    </div>
                    <!--end::Header-->
                    <!--begin::Body-->
                    <div class="card-body">
                        <div class="row">
                            <table id="productVariantsTable" class="table table-bordered table-striped compact">
                            </table>
                        </div>
                    </div>
                    <!--end::Body-->
                    <!--begin::Footer-->
                    @* <div class="card-footer d-flex justify-content-end">
                        <button type="button" class="btn btn-primary" id="saveButton">Kaydet</button>
                    </div> *@
                    <!--end::Footer-->
                </div>

            </div>
        </div>

    

    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->


@section Styles {
    <link href='~/lib/DataTables-2.3.8/datatables.min.css' rel='stylesheet' />
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/lib/DataTables-2.3.8/datatables.min.js"></script>
    <script src="~/lib/select2/js/select2.full.min.js"></script>

    <script>
        
        let productVariantsTable;

        $(document).ready(function () {
            $("#categoriesSelect").select2();
        });
        
        $(document).ready(function () {
            productVariantsTable = $("#productVariantsTable").DataTable({
                responsive: true,
                //"lengthChange": true,
                lengthMenu: [
                    [10, 25, 50, 100],
                    ['10', '25', '50', '100']
                ],
                //"autoWidth": false,

                //dom: 'Bfrtip',
