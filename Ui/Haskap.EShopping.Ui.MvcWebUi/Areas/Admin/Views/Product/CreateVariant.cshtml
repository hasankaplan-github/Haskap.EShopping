@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery

@*
    For more information on enabling MVC for empty projects, visit https://go.microsoft.com/fwlink/?LinkID=397860
*@

@{
    var antiforgeryToken = Antiforgery.GetAndStoreTokens(Context).RequestToken;

    var colorAttributes = (ViewBag.ColorAttributes as List<Modules.Catalog.Application.Backoffice.Dtos.ColorAttribute.OutputDto>) ?? [];
    var sizeAttributes = (ViewBag.SizeAttributes as List<Modules.Catalog.Application.Backoffice.Dtos.SizeAttribute.OutputDto>) ?? [];
}


<!--begin::App Content-->
<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">

        <vc:content-header title="Ürün Variantı Oluştur"></vc:content-header>

        <div class="row">
            <div class="col-md-12">

                <div class="card card-primary card-outline mb-4">
                    <!--begin::Header-->
                    <div class="card-header">
                        <div class="card-title">Ürün Variantı Oluştur</div>
                    </div>
                    <!--end::Header-->
                    <!--begin::Body-->
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Resimleri Seç</label>
                                <div class="custom-file">
                                    <input type="file" class="custom-file-input" id="photoFiles" multiple>
                                    <label class="custom-file-label" for="photoFiles">Resim</label>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <label for="colorAttributesSelect" class="form-label">Renk Seç</label>
                                <select id="colorAttributesSelect" class="select2" style="width: 100%;">
                                    <option value="">Renk Seç</option>
                                    @foreach (var colorAttribute in colorAttributes)
                                    {
                                        <option value="@colorAttribute.Id">
                                            <span style="color: @(colorAttribute.Value);">
                                                <i class="zmdi zmdi-circle"></i>
                                            </span> - @colorAttribute.DisplayName - @colorAttribute.Description
                                        </option>
                                    }
                                </select>
                            </div>

                            <div class="col-md-4">
                                <label for="sizeAttributesSelect" class="form-label">Beden Seç</label>
                                <select id="sizeAttributesSelect" class="select2" style="width: 100%;">
                                    <option value="">Beden Seç</option>
                                    @foreach (var sizeAttribute in sizeAttributes)
                                    {
                                        <option value="@sizeAttribute.Id">@sizeAttribute.DisplayName - @sizeAttribute.Description</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label for="priceInput" class="form-label">Ürün Fiyatı</label>
                                <input type="number" class="form-control" id="priceInput" />
                            </div>

                            <div class="col-md-3">
                                <label for="stockQuantityInput" class="form-label">Stok Miktarı</label>
                                <input type="number" class="form-control" id="stockQuantityInput" />
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Aktiflik</label>
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="isActiveInput" />
                                    <label class="form-check-label" for="isActiveInput">Aktif</label>
                                </div>
                            </div>

                            <div class="col-md-3">
                                <label class="form-label">Birincillik</label>
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="isPrimaryInput" />
                                    <label class="form-check-label" for="isPrimaryInput">Birincil</label>
                                </div>
                            </div>
                        </div>

                    </div>
                    <!--end::Body-->
                    <!--begin::Footer-->
                    <div class="card-footer d-flex justify-content-end">
                        <button type="button" class="btn btn-primary" id="saveButton">Kaydet</button>
                    </div>
                    <!--end::Footer-->
                </div>

            </div>
        </div>

    </div>
    <!--end::Container-->
</div>
<!--end::App Content-->


@section Styles {
    <link href="~/lib/select2/css/select2.min.css" rel="stylesheet" />
}

@section Scripts {
    <script src="~/lib/select2/js/select2.min.js"></script>
    <script src="~/lib/bs-custom-file-input/bs-custom-file-input.min.js"></script>

    <script>

        $(document).ready(function () {
            $(".select2").select2();
            bsCustomFileInput.init();
        });

        $('#saveButton').on("click", function () {
            let formData = new FormData();

            let colorAttributeId = $('#colorAttributesSelect').val();
            let sizeAttributeId = $('#sizeAttributesSelect').val();
            let priceValue = $('#priceInput').val();
            let stockQuantityValue = $('#stockQuantityInput').val();
            let isActive = $('#isActiveInput').is(':checked');
            let isPrimary = $('#isPrimaryInput').is(':checked');
            let photoFiles = $('#photoFiles')[0].files;

            for(let i = 0; i < photoFiles.length; i++){
                formData.append('photoFiles', photoFiles[i]);
            }
            formData.append('productId', '@ViewBag.ProductId');
            formData.append('colorAttributeId', colorAttributeId);
            formData.append('sizeAttributeId', sizeAttributeId);
            formData.append('priceValue', priceValue);
            formData.append('stockQuantityValue', stockQuantityValue);
            formData.append('isActive', isActive);
            formData.append('isPrimary', isPrimary);

            $.ajax({
                url: '@Url.Action("CreateVariant", "Product", new { area = "Admin" })',
                type: 'POST',
                headers: {
                    'RequestVerificationToken': '@antiforgeryToken'
                },
                data: formData,
                processData: false,  // tell jQuery not to process the data
                contentType: false  // tell jQuery not to set contentType
            }).done(function (result, status, xhr) {
                Swal.fire('Başarılı', 'Ürün variantı başarıyla kaydedildi.', 'success');

                $('#colorAttributesSelect').val(null)
                $('#sizeAttributesSelect').val(null)
                $('#priceInput').val('');
                $('#stockQuantityInput').val('');
                $('#isActiveInput').prop('checked', false);
                $('#isPrimaryInput').prop('checked', false);
            });
        });

    </script>
}